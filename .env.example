# Required in production (and recommended locally)
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://nippurpharma.com
NEXT_PUBLIC_SITE_URL=https://nippurpharma.com

# Database
DATABASE_URL=

# Admin seed (preferred): create first admin when missing
ADMIN_EMAIL=admin@nippurpharma.iq
ADMIN_PASSWORD=

# Local only: allow weak default seed user (never on production)
# ALLOW_DEV_SEED=1

# Behind Caddy / Cloudflare / reverse proxy (Vercel sets this automatically)
# TRUSTED_PROXY=1
# CF_PROXY=1

# Shared rate limits (recommended for production / multi-instance)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Brevo (Sendinblue) — newsletter dual-sync
# Create key: Brevo → SMTP & API → API Keys
# List ID: Brevo → Contacts → Lists → list number
BREVO_API_KEY=
BREVO_LIST_ID=

# Vercel Blob — required on Vercel for CV uploads (local disk is read-only)
# Connect a Blob store to the project (Storage → Blob → Connect Project).
# Private stores need access:'private' in code (already configured).
# BLOB_STORE_ID is auto-added when connected; also add/copy:
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
